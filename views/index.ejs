<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PC Parts Inventory</title>
    <link rel="stylesheet" href="/styles/main.css" />
  </head>
  <body>
    <header>
      <h1>PC Parts Inventory</h1>
      <p>Browse and manage categories, manufacturers, and inventory items.</p>
    </header>

    <main>
      <section>
        <h2>Browse Inventory</h2>

        <nav>
          <ul>
            <li>
              <a href="/categories">View Categories</a>
            </li>
            <li>
              <a href="/manufacturers">View Manufacturers</a>
            </li>
            <li>
              <a href="/items">View Items</a>
            </li>
          </ul>
        </nav>
      </section>

      <section>
        <h2>Manage Inventory</h2>

        <nav>
          <ul>
            <li>
              <a href="/categories/new">Add Category</a>
            </li>
            <li>
              <a href="/manufacturers/new">Add Manufacturer</a>
            </li>
            <li>
              <a href="/items/new">Add Item</a>
            </li>
          </ul>
        </nav>
      </section>
    </main>
  </body>
</html>
