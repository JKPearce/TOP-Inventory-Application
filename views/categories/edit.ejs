<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%= category.name %> | PC Parts Inventory</title>
    <link rel="stylesheet" href="/styles/main.css" />
  </head>
  <body>
    <header>
      <h1>Edit Category</h1>
      <p>Update category details.</p>

      <div class="page-actions">
        <a class="button secondary" href="/categories/<%= category.id %>"
          >Back to Category</a
        >
        <a class="button secondary" href="/categories">Back to Categories</a>
        <a class="button secondary" href="/">Home</a>
      </div>
    </header>

    <main>
      <section>
        <h2><%= category.name %></h2>

        <form action="/categories/<%= category.id %>/edit" method="POST">
          <label>
            Name
            <input
              type="text"
              name="name"
              required
              maxlength="100"
              value="<%= category.name %>"
            />
          </label>

          <label>
            Description
            <textarea
              name="description"
              placeholder="Short description of the category"
            >
<%= category.description || '' %></textarea
            >
          </label>

          <button type="submit">Update Category</button>
        </form>
      </section>
    </main>
  </body>
</html>
